{
  "type": "object",
  "additionalProperties": false,
  "required": ["responses", "new_findings"],
  "properties": {
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position", "argument", "revised_fix"],
        "properties": {
          "id": { "type": "string" },
          "position": { "type": "string", "enum": ["concede", "maintain", "revise"] },
          "argument": { "type": "string" },
          "revised_fix": { "type": "string" }
        }
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "title", "failure", "fix"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "title": { "type": "string" },
          "failure": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    }
  }
}
